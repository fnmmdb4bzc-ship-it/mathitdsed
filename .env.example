# MathIT on Netlify - function environment.
# Set these in the Netlify UI (Site configuration > Environment variables), or
# copy to .env for `netlify dev`.

# --- Database -------------------------------------------------------------
# Netlify DB injects NETLIFY_DATABASE_URL automatically once provisioned.
# Set DATABASE_URL only to point at something else (e.g. the compose Postgres).
# DATABASE_URL=postgres://mathit:mathit_dev_pw@localhost:5432/mathit

# --- Identity -------------------------------------------------------------
# Any OIDC issuer. Endpoints are resolved from its discovery document, so no
# provider-specific URLs appear anywhere in the code.
OIDC_ISSUER=http://localhost:8081/realms/mathit
OIDC_CLIENT_ID=mathit-web

# Where the roles claim lives, if the provider does not use Keycloak's
# realm_access.roles. Ignored when that claim is present.
# OIDC_ROLES_CLAIM=roles

# Sign-up page, for providers that do not expose one next to /auth.
# OIDC_SIGNUP_URL=

# --- Identity management API ----------------------------------------------
# Which adapter in netlify/lib/identity/ handles admin operations.
IDENTITY_PROVIDER=keycloak

# keycloak: one address now - a function has no private network, so the
# compose-era split between public issuer and internal URL is gone.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=mathit
KEYCLOAK_API_CLIENT_ID=mathit-api
KEYCLOAK_API_CLIENT_SECRET=change-me

# clerk: not yet implemented - see netlify/lib/identity/clerk.mjs
# CLERK_SECRET_KEY=
