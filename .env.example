# MathIT on Netlify - function environment.
# Set these in the Netlify UI (Project configuration > Environment variables),
# or copy to .env for `netlify dev`.
#
# The headline is what is NOT here: with Netlify Identity and Netlify Database
# there are no secrets to configure at all. The function reaches both through
# the Netlify runtime - the Identity operator token and the database connection
# are injected into it - so a working deployment needs nothing in this file.
# Everything below is either an override or an alternative provider.

# --- Identity ------------------------------------------------------------
# 'netlify' (default), 'clerk' or 'keycloak'.
# IDENTITY_PROVIDER=netlify

# Netlify Identity is email-and-password; GoTrue has no username field. A
# student with no email of their own is created with a synthetic address under
# this domain and signs in with just the local part - "anna" becomes
# anna@students.mathit.invalid. .invalid is reserved by RFC 2606 and can never
# resolve, which is the point: those accounts are auto-confirmed and no mail is
# ever sent to them. Change it only if you would rather see your own domain in
# the Identity tab; do not point it at a domain that receives mail.
# IDENTITY_EMAIL_DOMAIN=students.mathit.invalid

# --- Database ------------------------------------------------------------
# Netlify Database is reached through @netlify/database with no configuration.
# Set DATABASE_URL only to point somewhere else - the compose Postgres, or a
# scratch database you are testing a migration against.
# DATABASE_URL=postgres://mathit:mathit_dev_pw@localhost:5432/mathit

# --- Clerk (alternative provider) ----------------------------------------
# IDENTITY_PROVIDER=clerk
# OIDC_ISSUER=https://clerk.your-domain.com
# OIDC_CLIENT_ID=
# OIDC_SIGNUP_URL=https://accounts.your-domain.com/sign-up
# CLERK_SECRET_KEY=
# CLERK_API_URL=https://api.clerk.com/v1

# --- Keycloak (alternative provider) -------------------------------------
# Keeps the original docker-compose stack working, which is what makes the
# port testable against something real before anything is deployed.
# IDENTITY_PROVIDER=keycloak
# OIDC_ISSUER=http://localhost:8081/realms/mathit
# OIDC_CLIENT_ID=mathit-web
# KEYCLOAK_URL=http://localhost:8081
# KEYCLOAK_REALM=mathit
# KEYCLOAK_API_CLIENT_ID=mathit-api
# KEYCLOAK_API_CLIENT_SECRET=change-me
