# MathIT on Netlify - function environment.
# Set these in the Netlify UI (Site configuration > Environment variables), or
# copy to .env for `netlify dev`.

# --- Database -------------------------------------------------------------
# Netlify DB injects NETLIFY_DATABASE_URL automatically once provisioned.
# Set DATABASE_URL only to point somewhere else (e.g. the compose Postgres).
# DATABASE_URL=postgres://mathit:mathit_dev_pw@localhost:5432/mathit

# --- Identity -------------------------------------------------------------
IDENTITY_PROVIDER=clerk

# The OIDC issuer. For Clerk this is the Frontend API domain, which publishes
# /.well-known/openid-configuration; the function reads the authorization,
# token and logout endpoints from there so no URLs are hardcoded anywhere.
OIDC_ISSUER=https://clerk.your-domain.com

# The OAuth application's client id (Clerk dashboard > OAuth Applications).
# Create it as a *public* client with PKCE required - the browser holds no
# secret. Introspection checks tokens were issued to this client id.
OIDC_CLIENT_ID=

# Clerk's hosted sign-up page. Clerk has no /registrations sibling to the
# authorize endpoint the way Keycloak does, so it has to be given explicitly.
OIDC_SIGNUP_URL=https://accounts.your-domain.com/sign-up

# Backend API key (Clerk dashboard > API Keys > Secret key). Used for token
# introspection and every admin operation.
CLERK_SECRET_KEY=

# Override only for testing against a different Clerk API host.
# CLERK_API_URL=https://api.clerk.com/v1

# --- Keycloak (alternative provider) --------------------------------------
# IDENTITY_PROVIDER=keycloak keeps the original stack working, which is what
# makes the port testable against docker-compose before Clerk is set up.
# OIDC_ISSUER=http://localhost:8081/realms/mathit
# OIDC_CLIENT_ID=mathit-web
# KEYCLOAK_URL=http://localhost:8081
# KEYCLOAK_REALM=mathit
# KEYCLOAK_API_CLIENT_ID=mathit-api
# KEYCLOAK_API_CLIENT_SECRET=change-me
